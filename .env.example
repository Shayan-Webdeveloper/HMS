# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string. Use a least-privilege role in production.
DATABASE_URL="postgresql://hms_app:CHANGE_ME@localhost:5432/hms?schema=public"
# Used only by `npm run test:integration` — must point at a disposable database.
TEST_DATABASE_URL="postgresql://hms_app:CHANGE_ME@localhost:5432/hms_test?schema=public"

# ── App / auth ───────────────────────────────────────────
# Long random string (e.g. `openssl rand -base64 48`). Used to sign document download links.
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"
# Session lifetime in hours (absolute) and idle timeout in minutes.
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=60

# ── Email ────────────────────────────────────────────────
# "log" (development: emails are written to the server console + storage/mail-log) or "smtp".
EMAIL_PROVIDER="log"
EMAIL_FROM="Hospital <no-reply@example.com>"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# ── File storage ─────────────────────────────────────────
# "local" stores files privately under ./storage/uploads (never served publicly).
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_LOCAL_DIR="./storage/uploads"
FILE_MAX_BYTES=10485760

# ── Development-only admin bootstrap (npm run create-admin) ──
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# ── Development-only demo data (npm run seed) ──
# Password for every demo account. If empty, a random one is generated and printed once.
SEED_DEMO_PASSWORD=""
