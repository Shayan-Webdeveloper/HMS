# Configuration template. Copy to `.env` (never committed) and fill in real values locally,
# or set the same variables in your hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# Every value below is a PLACEHOLDER. Never put real credentials in this file.
#
# Which values are SECRETS (rotate them if they ever leak):
#   DATABASE_URL (contains the DB password), TEST_DATABASE_URL, AUTH_SECRET, SUPABASE_SERVICE_ROLE_KEY,
#   EMAIL_SERVER_PASSWORD, ADMIN_PASSWORD / PLATFORM_ADMIN_PASSWORD (one-off bootstrap), SEED_DEMO_PASSWORD.
# Everything else is ordinary configuration.

# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string used by the app AND by `prisma migrate deploy`.
# The app does NOT rely on this role for tenant isolation: every query is executed under the
# restricted `hms_app` database role with a per-transaction hospital context (see docs/SECURITY.md).
# Supabase on Vercel/serverless: use the *transaction* pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Only for integration tests. Must point at a DISPOSABLE database — tests create and drop data.
# Leave empty to let `npm run test:db` start a throwaway embedded PostgreSQL automatically.
TEST_DATABASE_URL=""

# ── App / auth ───────────────────────────────────────────
# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production with a missing, short or placeholder value.
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"
# Session lifetime in hours (absolute) and idle timeout in minutes.
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=60

# ── Email ────────────────────────────────────────────────
# "log" (development: messages go to the server console / storage/mail-log) or "smtp".
EMAIL_PROVIDER="log"
EMAIL_FROM="Hospital <no-reply@example.com>"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# ── File storage ─────────────────────────────────────────
# "local"    → files kept privately under FILE_STORAGE_LOCAL_DIR (development; NOT persistent on Vercel).
# "supabase" → private Supabase Storage bucket, accessed only from the server.
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_LOCAL_DIR="./storage/uploads"
FILE_MAX_BYTES=10485760
# Required when FILE_STORAGE_PROVIDER="supabase". The service-role key is a SECRET: server-side only,
# never prefix it with NEXT_PUBLIC_. Create the bucket with `npm run storage:setup`.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hms-documents"

# ── Demo accounts ────────────────────────────────────────
# Demo accounts (@demo.hms) are refused at login when NODE_ENV=production unless this is "true".
# Only set it for a public DEMO deployment that contains synthetic data, never for a real hospital.
ALLOW_DEMO_ACCOUNTS="false"

# ── One-off bootstrap (remove the passwords after use) ──
# npm run create-admin           → first administrator of a hospital
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
HOSPITAL_CODE=""
# npm run create-platform-admin  → Platform Administrator (manages hospitals; no clinical access)
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_NAME=""
PLATFORM_ADMIN_PASSWORD=""

# ── Development-only demo data (npm run seed) ──
# Password for every demo account (12+ characters). If empty, a random one is generated and printed once.
# Must NOT be reused for any real account.
SEED_DEMO_PASSWORD=""
